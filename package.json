{
  "name": "extshare",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "server": "bun run packages/server/src/main.ts",
    "admin": "bun run packages/server/src/admin.ts",
    "cli": "bun run packages/cli/src/main.ts",
    "build:cli": "bun build packages/cli/src/main.ts --compile --outfile dist/extshare",
    "build:server": "bun build packages/server/src/main.ts --target bun --outdir dist/server",
    "verify:sqlite": "bun test ./packages/server/test/sqlite.owner.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
