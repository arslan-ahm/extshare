# extshare server configuration. Copy to .env (never commit it) and fill in.

# Public origin testers and the CLI reach. Must be https:// except for localhost.
PUBLIC_URL=https://extshare.example.com
HOST=127.0.0.1
PORT=8787
# Where the SQLite database and uploaded packages live. Back this directory up.
DATA_DIR=./data
# Signs short-lived cookies. Generate: openssl rand -base64 48
SECRET=
# Set to true only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY=false
# How often (seconds) to poll the Web Store for review results and expire releases.
SYNC_INTERVAL_SEC=120

# --- Chrome Web Store API v2 (publishing) ---
# Developer Dashboard > Publisher > Settings
CWS_PUBLISHER_ID=
# Option A (recommended for servers): service account linked in the Developer Dashboard (Account section)
CWS_SERVICE_ACCOUNT_FILE=
# Option B: OAuth client + refresh token (see README, "Chrome Web Store credentials")
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# --- Google sign-in for testers (OpenID Connect) ---
# OAuth client of type "Web application" with redirect URI ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
