{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": { "includes": ["packages/**", "*.json", "!**/node_modules", "!**/dist"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "a11y": { "noSvgWithoutTitle": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
